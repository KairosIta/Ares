# Identita' logica usata per separare profilo e memorie.
ARES_USER_ID=default

# Modello conversazionale. Omesso, Ares usa MODELLO_LOCALE di config.py e
# nessuna conversazione lascia la macchina. Un nome col tag `:cloud` fa
# inoltrare dal daemon Ollama a ollama.com tutto cio' che il modello riceve:
# domande e risposte, profilo e memorie nel prompt, i file che legge,
# l'output dei comandi, le conversazioni passate che rilegge.
# ARES_MAIN_MODEL=glm-5.3-flash:cloud

# Modello per l'estrazione delle memorie. Omesso, resta MODELLO_LOCALE anche
# con la conversazione in cloud. Un nome col tag `:cloud` manda a ollama.com
# il testo dei turni e le memorie gia' salvate: e' la scelta di chi vuole
# solo modelli cloud. L'embedding resta locale comunque, e il codice lo impone.
# ARES_LEARNING_MODEL=glm-5.3-flash:cloud

# Contesto chiesto a Ollama, in token. Omesso vale 131072 (128k), che tiene
# il modello locale di serie tutto in VRAM su 16 GiB. Con meno VRAM va
# abbassato: `ares preflight`, dopo un turno di chat, dice se il modello
# gira in parte sulla CPU. Minimo 8192.
# ARES_NUM_CTX=131072

# Campionamento del modello conversazionale. Omessi valgono i default di
# Ollama, scritti qui sotto: Ares li manda espliciti, cosi' si sa cosa gira.
# Le schede dei modelli ne consigliano spesso altri (Qwen3.5 e derivati:
# temperatura 1.0, top_p 0.95, top_k 20, presence_penalty 1.5,
# repeat_penalty 1.0 per l'uso generale). Tutti tranne la temperatura valgono
# anche per l'estrazione delle memorie, che ha la sua temperatura in
# config.py. Un valore fuori intervallo ferma l'avvio con una riga.
# ARES_TEMPERATURE=0.7
# ARES_TOP_P=0.9
# ARES_TOP_K=40
# ARES_MIN_P=0.0
# ARES_REPEAT_PENALTY=1.1
# ARES_PRESENCE_PENALTY=0.0

# Con un modello di estrazione locale, il contesto di sessione si estrae
# come JSON vincolato dallo schema (il `format` di Ollama) invece che con una
# tool call: un modello piccolo non puo' dimenticare la chiamata o
# sbagliarne la forma. Con un modello cloud resta la tool call, perche' il
# cloud di Ollama non applica lo schema. 0 lo spegne, per confrontare.
# ARES_ESTRAZIONE_VINCOLATA=0

# Gli strumenti di entita' e intuizioni non arrivano al modello finche' non
# li attiva con `attiva_strumenti`: il prompt li descrive con una riga per
# gruppo, e una volta attivati restano per la conversazione. Toglie circa un
# quinto di cio' che il modello legge a ogni richiesta. 0 li da' tutti da
# subito, come prima.
# ARES_STRUMENTI_SU_RICHIESTA=0

# I comandi dentro bubblewrap, solo su Linux: scrivono nella cartella e in una
# /tmp privata, non vedono lo stato di Ares ne' le credenziali della home, non
# hanno la rete. Se bwrap manca o non crea i namespace la chat non parte.
# ARES_SANDBOX=bwrap
# La rete dentro la sandbox, intera e senza filtro per dominio.
# ARES_SANDBOX_RETE=1

# Le skill di ~/.ares/skills e di .ares/skills nella cartella, e le proposte
# di Ares in ~/.ares/skills/proposte (`ares skills`). 0 le spegne tutte.
# ARES_SKILL=0

# Percorsi opzionali. Se omessi, stato e backup vivono in ~/.ares (`stato/`
# e `backup/`). ARES_HOME sposta tutto in blocco, gli altri due una parte
# sola. La cartella di lavoro non si configura: e' quella da cui lanci
# `ares`, oppure quella passata con `ares --workspace PERCORSO`.
# ARES_HOME=/percorso/alla/casa/di/ares
# ARES_TMP=/percorso/allo/stato
# ARES_BACKUP_DIR=/percorso/ai/backup
