# Identita' logica usata per separare profilo e memorie.
ARES_USER_ID=default

# Modello conversazionale. Omesso, Ares usa MODELLO_LOCALE di config.py e
# nessuna conversazione lascia la macchina. Un nome col tag `:cloud` la fa
# inoltrare dal daemon Ollama a ollama.com.
# ARES_MAIN_MODEL=glm-5.3-flash:cloud

# Modello per l'estrazione delle memorie. Omesso, resta MODELLO_LOCALE anche
# con la conversazione in cloud. Un nome col tag `:cloud` manda a ollama.com
# il testo dei turni e le memorie gia' salvate: e' la scelta di chi vuole
# solo modelli cloud. L'embedding resta locale comunque, e il codice lo impone.
# ARES_LEARNING_MODEL=glm-5.3-flash:cloud

# Percorsi opzionali. Se omessi, Ares usa directory accanto al progetto.
# La cartella di lavoro non si configura: e' quella da cui lanci `ares`,
# oppure quella passata con `ares --workspace PERCORSO`.
# ARES_TMP=/percorso/allo/stato
# ARES_BACKUP_DIR=/percorso/ai/backup
